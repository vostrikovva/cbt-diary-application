{
  "name": "cbt-diary-application",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w mobile",
    "prebuild": "npm run prebuild -w mobile",
    "android": "npm run android -w mobile",
    "android:device": "npm run android -w mobile -- --device",
    "typecheck": "npm run typecheck -w mobile",
    "lint": "npm run lint -w mobile",
    "build:apk:gradle": "npm run build:apk:gradle -w mobile",
    "build:apk:gradle:release": "npm run build:apk:gradle:release -w mobile",
    "build:aab:gradle": "npm run build:aab:gradle -w mobile",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx}": "eslint -c apps/mobile/eslint.config.js --max-warnings=0"
  },
  "devDependencies": {
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.14.0"
  }
}
